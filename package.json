{
  "name": "issue-link-push",
  "displayName": "Issue Link Push",
  "description": "关联 DevOps 任务并自动生成规范的提交信息且推送代码。",
  "version": "0.3.12",
  "publisher": "lkk-vscode-2136",
  "author": {
    "name": "LKK",
    "email": "your-email@example.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liukuankuan2136/git-push.git"
  },
  "homepage": "https://github.com/liukuankuan2136/git-push#readme",
  "bugs": {
    "url": "https://github.com/liukuankuan2136/git-push/issues"
  },
  "keywords": [
    "DevOps",
    "Git",
    "Commit",
    "Workhour"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "icon": "icon.png",
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onCommand:issueLinkPush.submitWithDevOpsTask",
    "onCommand:issueLinkPush.commitAndPush",
    "onCommand:issueLinkPush.commitOnly",
    "onCommand:issueLinkPush.initializeDevOps",
    "onCommand:issueLinkPush.clearCache",
    "onCommand:issueLinkPush.opsWorkHourRecord",
    "onCommand:issueLinkPush.regionCheck",
    "onCommand:issueLinkPush.pushDayWork",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "issueLinkPush.submitWithDevOpsTask",
        "title": "关联 DevOps 任务并推送",
        "category": "Issue Link Push",
        "icon": "$(checklist)"
      },
      {
        "command": "issueLinkPush.initializeDevOps",
        "title": "初始化 DevOps 账号",
        "category": "Issue Link Push",
        "icon": "$(account)"
      },
      {
        "command": "issueLinkPush.clearCache",
        "title": "清除 DevOps 缓存",
        "category": "Issue Link Push",
        "icon": "$(clear-all)"
      },
      {
        "command": "issueLinkPush.commitAndPush",
        "title": "关联 DevOps 任务提交并推送",
        "category": "Issue Link Push",
        "icon": "$(git-commit)"
      },
      {
        "command": "issueLinkPush.commitOnly",
        "title": "关联 DevOps 任务仅提交",
        "category": "Issue Link Push",
        "icon": "$(save)"
      },
      {
        "command": "issueLinkPush.opsWorkHourRecord",
        "title": "运维工时补录",
        "category": "Issue Link Push",
        "icon": "$(debug-start)"
      },
      {
        "command": "issueLinkPush.regionCheck",
        "title": "区域合规检查",
        "category": "Issue Link Push",
        "icon": "$(location)"
      },
      {
        "command": "issueLinkPush.pushDayWork",
        "title": "提交日报",
        "category": "Issue Link Push",
        "icon": "$(notebook)"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "issueLinkPush.submitWithDevOpsTask",
          "group": "navigation"
        },
        {
          "command": "issueLinkPush.commitAndPush",
          "group": "navigation"
        },
        {
          "command": "issueLinkPush.commitOnly",
          "group": "navigation"
        },
        {
          "command": "issueLinkPush.opsWorkHourRecord",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "issueLinkPush.submitWithDevOpsTask"
        },
        {
          "command": "issueLinkPush.initializeDevOps"
        },
        {
          "command": "issueLinkPush.clearCache"
        },
        {
          "command": "issueLinkPush.commitAndPush"
        },
        {
          "command": "issueLinkPush.commitOnly"
        },
        {
          "command": "issueLinkPush.opsWorkHourRecord"
        },
        {
          "command": "issueLinkPush.regionCheck"
        },
        {
          "command": "issueLinkPush.pushDayWork"
        }
      ]
    },
    "configuration": {
      "title": "Issue Link Push",
      "properties": {
        "issueLinkPush.commitTemplate": {
          "type": "string",
          "default": "${COMMIT_TYPE}:${SUBJECT} scrum -e ${CODE} -h:${HOURS} -s:${PROGRESS}",
          "description": "Commit message template. Supports ${COMMIT_TYPE}, ${SUBJECT}, ${CODE}, ${HOURS}, ${PROGRESS}, ${TYPE}, ${PROJECT}."
        },
        "issueLinkPush.requestTimeoutMs": {
          "type": "number",
          "default": 10000,
          "minimum": 1000,
          "description": "DevOps API request timeout in milliseconds."
        },
        "issueLinkPush.cacheTtlMs": {
          "type": "number",
          "default": 300000,
          "minimum": 0,
          "description": "Local DevOps product and task cache TTL in milliseconds. Set to 0 to disable caching."
        },
        "issueLinkPush.workHourMode": {
          "type": "string",
          "enum": [
            "append",
            "overwrite"
          ],
          "default": "append",
          "description": "工时记录模式。追加：新工时累加到当天已有工时；覆盖：新工时替换当天已有工时。"
        },
        "issueLinkPush.workContentMode": {
          "type": "string",
          "enum": [
            "append",
            "overwrite"
          ],
          "default": "append",
          "description": "工时描述记录模式。追加：新描述追加到已有描述末尾；覆盖：新描述替换已有描述。"
        },
        "issueLinkPush.debugMode": {
          "type": "boolean",
          "default": false,
          "description": "运维模式。开启后在 Issue Link Push 输出通道打印请求/响应调试日志。"
        },
        "issueLinkPush.progressMode": {
          "type": "string",
          "enum": [
            "append",
            "overwrite"
          ],
          "default": "overwrite",
          "description": "任务百分比记录模式。追加：新百分比累加到当天已有百分比（上限 100%）；覆盖：新百分比替换已有百分比。"
        },
        "issueLinkPush.taskCreateMode": {
          "type": "string",
          "enum": [
            "simple",
            "normal",
            "benchmark"
          ],
          "default": "simple",
          "description": "运维工时补录时 Task 内容填写模式。简易：仅输入任务描述；普通：输入任务描述 + 验收标准；标杆：逐章节完整填写（可回车跳过）。"
        },
        "issueLinkPush.upgradeReminder": {
          "type": "boolean",
          "default": false,
          "description": "升级提醒。开启后，扩展更新时弹出升级提醒通知。默认关闭。"
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.5"
  }
}
